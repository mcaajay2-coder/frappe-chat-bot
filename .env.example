# ==============================================================================
# KOINONIA ASSISTANT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ─── Sarvam AI (Tamil / Tanglish / English Speech-to-Text) ────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ─── Groq API Keys (Multi-Key Rotation Pool) ──────────────────────────────────
# Comma-separated list of Groq API keys for automatic load balancing and failover
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=gsk_key1

# ─── PostgreSQL Vector DB (pgvector) ──────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=parish_vectordb
PG_USER=postgres
PG_PASS=password

# ─── LangSmith Tracing & Observability (Optional) ─────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=koinonia_assistant
